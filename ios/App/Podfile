require_relative '../../node_modules/@capacitor/ios/scripts/pods_helpers'

platform :ios, '15.0'
use_frameworks!

# workaround to avoid Xcode caching of Pods that requires
# Product -> Clean Build Folder after new Cordova plugins installed
# Requires CocoaPods 1.6 or newer
install! 'cocoapods', :disable_input_output_paths => true

# ATENCION: dos plugins estan deliberadamente FUERA de esta lista.
#
# 1. CodetrixStudioCapacitorGoogleAuth (acceso con Google en iOS).
#    Arrastra GoogleSignIn 6.2.4, GTMAppAuth 1.3.1 y GTMSessionFetcher 2.3.0.
#    Ninguna de esas versiones incluye manifiesto de privacidad, obligatorio en
#    los SDK de terceros desde 2024, y Apple rechaza el binario con
#    ITMS-91061 (Missing privacy manifest). El podspec del plugin fija
#    'GoogleSignIn ~> 6.2.4' incluso en su ultima version publicada, de modo que
#    no existe actualizacion que lo resuelva. El paquete SIGUE instalado en
#    package.json porque Android lo usa con normalidad: lo unico que se excluye
#    es su compilacion en iOS.
#
# 2. CapacitorPushNotifications. El paquete se retiro de package.json el 25 de
#    agosto (crasheaba la app de Android al arrancar por Firebase sin
#    configurar), pero esta linea se quedo aqui apuntando a una carpeta que ya
#    no existe: cualquier 'pod install' sobre un clon limpio fallaba.
#
# SI EJECUTAS 'npx cap sync ios' ESTE ARCHIVO SE REGENERA y el plugin de Google
# vuelve a entrar, con otro rechazo de Apple detras. Tras un sync, vuelve a
# quitar esa linea antes de archivar.

def capacitor_pods
  pod 'Capacitor', :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorCordova', :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorCommunityAppleSignIn', :path => '../../node_modules/@capacitor-community/apple-sign-in'
  pod 'CapacitorCommunityPrivacyScreen', :path => '../../node_modules/@capacitor-community/privacy-screen'
  pod 'CapacitorApp', :path => '../../node_modules/@capacitor/app'
  pod 'CapacitorBrowser', :path => '../../node_modules/@capacitor/browser'
  pod 'CapacitorCamera', :path => '../../node_modules/@capacitor/camera'
  pod 'CapacitorFilesystem', :path => '../../node_modules/@capacitor/filesystem'
  pod 'CapacitorHaptics', :path => '../../node_modules/@capacitor/haptics'
  pod 'CapacitorPreferences', :path => '../../node_modules/@capacitor/preferences'
  pod 'CapacitorShare', :path => '../../node_modules/@capacitor/share'
  pod 'CapacitorStatusBar', :path => '../../node_modules/@capacitor/status-bar'
  pod 'SentryCapacitor', :path => '../../node_modules/@sentry/capacitor'
end

target 'App' do
  capacitor_pods
  # Add your Pods here
end

post_install do |installer|
  assertDeploymentTarget(installer)
end
