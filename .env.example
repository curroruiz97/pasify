# =============================================================================
# Pasify — Variables de entorno
# =============================================================================
# Copia este archivo a .env.local para desarrollo, o configura en Vercel/CI.
# Las variables VITE_* se embeben en el bundle del cliente (NO secretas).
# Las variables sin prefijo VITE_ son SERVER-SIDE (Supabase secrets, Vercel
# secrets) y NUNCA deben ir en el cliente.
#
# Setup deploy Vercel: ver DEPLOY_VERCEL.md para la lista exacta + dónde
# pegarlas en Vercel Dashboard → Settings → Environment Variables.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — cliente (NO secretas; van en el bundle)
# -----------------------------------------------------------------------------
VITE_SUPABASE_PROJECT_ID="ixkyfwzkknehvsqpopof"
VITE_SUPABASE_URL="https://ixkyfwzkknehvsqpopof.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Bypass de auth en dev cuando no hay anon key (solo modo preview UI local).
VITE_DEV_PREVIEW="false"

# -----------------------------------------------------------------------------
# Stripe — cliente
# -----------------------------------------------------------------------------
VITE_STRIPE_PUBLISHABLE_KEY=""
VITE_STRIPE_TEST_MODE="false"

# -----------------------------------------------------------------------------
# Integraciones externas — cliente
# -----------------------------------------------------------------------------
VITE_MAPBOX_PUBLIC_TOKEN=""
VITE_GOOGLE_OAUTH_CLIENT_ID=""
VITE_FCM_VAPID_KEY=""
VITE_SENTRY_DSN=""
VITE_POSTHOG_KEY=""
VITE_POSTHOG_HOST="https://eu.i.posthog.com"
VITE_TURNSTILE_SITE_KEY=""

# -----------------------------------------------------------------------------
# Aplicación — URLs públicas
# -----------------------------------------------------------------------------
# Dominio público actual:
#   - DEV local            → http://localhost:8080
#   - STAGING/preview      → https://pasifyy.vercel.app
#   - PROD definitivo      → https://pasify.es
VITE_APP_BASE_URL="https://pasifyy.vercel.app"
VITE_PUBLIC_WEB_URL="https://pasifyy.vercel.app"
VITE_APP_NAME="Pasify"
VITE_DEFAULT_LOCALE="es"
VITE_SUPPORT_EMAIL="hola@pasify.es"

# =============================================================================
# SERVERLESS FUNCTIONS (Vercel /api/*) — variables expuestas al runtime Node
# =============================================================================
# Se configuran en Vercel Dashboard → Settings → Environment Variables.
# El handler /api/e/[id].ts las lee con process.env.*.
# -----------------------------------------------------------------------------
SITE_URL="https://pasifyy.vercel.app"
SUPABASE_URL="https://ixkyfwzkknehvsqpopof.supabase.co"
SUPABASE_ANON_KEY=""

# =============================================================================
# SUPABASE SECRETS — edge functions server-side (no commitear nunca)
# =============================================================================
# Para edge functions, usa: supabase secrets set KEY=value
# Para Vercel, usa el dashboard de Environment Variables.
# Ver `secrets.template.env` para la lista completa con descripciones.
# -----------------------------------------------------------------------------

# Supabase service role (nunca al cliente)
# SUPABASE_SERVICE_ROLE_KEY=""

# Stripe — server (edge functions)
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# STRIPE_CONNECT_CLIENT_ID=""

# Email transaccional (Resend recomendado; Gmail SMTP fallback legacy)
# RESEND_API_KEY=""
# EMAIL_FROM="Pasify <noreply@pasify.es>"
# EMAIL_REPLY_TO="hola@pasify.es"

# SMS / 2FA
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_NUMBER=""

# Push notifications (Firebase Admin)
# FIREBASE_SERVICE_ACCOUNT_JSON=""

# AI providers
# OPENAI_API_KEY=""

# Captcha
# TURNSTILE_SECRET_KEY=""

# Administración
# ADMIN_EMAIL="hola@pasify.es"
# ADMIN_SLACK_WEBHOOK=""
