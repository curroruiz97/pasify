<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">
    <!-- ============================================================
         PERMISSIONS · justificados por los plugins Capacitor en uso
         INTERNET .................... Supabase/Stripe/Sentry (obligatorio)
         CAMERA ...................... @capacitor/camera + QR scanner (html5-qrcode)
         RECORD_AUDIO ................ notas de voz del chat (VoiceRecorderButton →
                                       getUserMedia({audio:true}) + MediaRecorder).
                                       Sin este permiso la WebView deniega la
                                       captura y el boton del microfono falla
                                       siempre en Android.
         POST_NOTIFICATIONS .......... @capacitor/push-notifications runtime (SDK 33+)

         NO añadir READ_MEDIA_IMAGES ni READ_MEDIA_VIDEO.
         Estaban declarados a mano desde el commit de mayo 2026 y no los pide
         ninguna librería: ningún AndroidManifest de node_modules los menciona.
         @capacitor/camera declara el alias PHOTOS con `strings = {}` (cero
         permisos) y elige fotos con ActivityResultContracts.PickVisualMedia,
         es decir, el selector de fotos del sistema. Los permisos amplios de
         almacenamiento sobraban.

         Google Play los detectó en las comprobaciones previas del 16 ago 2026
         ("Usar selectores de sistema alternativos para fotos o vídeos"): la
         política solo los permite en apps que apuntan a API 33+ cuando los
         selectores del sistema no bastan para la funcionalidad principal, y
         aquí bastan de sobra.
         ============================================================ -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- USE_CREDENTIALS lo arrastra @codetrix-studio/capacitor-google-auth en su
         propio manifest. Es un permiso obsoleto que Android ELIMINÓ en API 23, y
         el minSdk de esta app es justo 23: no hace absolutamente nada salvo
         aparecer en la lista de permisos de la ficha de Play y dar que pensar a
         quien la lee. Lo quitamos de la fusión. -->
    <uses-permission android:name="android.permission.USE_CREDENTIALS" tools:node="remove" />

    <!-- Ni cámara ni micrófono son obligatorios: así la app sigue siendo
         instalable en tablets y dispositivos sin ese hardware. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Deep link OAuth callback: Supabase / GoogleAuth devuelven a la app
                 vía es.pasify.app://callback. El listener vive en src/App.tsx:309
                 (CapacitorApp.addListener('appUrlOpen', ...)). -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="es.pasify.app" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
