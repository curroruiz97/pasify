# =============================================================================
# Pasify — configuración PÚBLICA de producción (versionada a propósito)
# =============================================================================
# Estos valores NO son secretos: viajan dentro del bundle JS que sirve
# pasifyy.vercel.app y que se empaqueta dentro del AAB de Android. Cualquiera
# puede leerlos abriendo devtools. La seguridad real la da RLS en Postgres,
# no el ocultamiento de la publishable key.
#
# POR QUÉ ESTÁ VERSIONADO
# El AAB de Android se compila en local (`npm run android:build:bundle`).
# Antes, la única fuente de estas variables era `.env.local`, que está en
# .gitignore. Un clon limpio compilaba sin ellas, el bundle salía apuntando a
# https://placeholder.supabase.co y el login moría con "Failed to fetch".
# Google Play rechazó la versión del 15 ago 2026 exactamente por eso.
#
# PRECEDENCIA (de menor a mayor, según Vite)
#   .env.production  →  .env.local  →  variables reales de entorno
# Es decir: en Vercel siguen mandando las del dashboard, y en tu máquina
# sigue mandando tu .env.local. Este fichero solo es la red de seguridad
# para que un clon limpio nunca compile un binario roto.
#
# Los secretos de verdad (service role, Stripe secret, Resend, Twilio…) NO
# van aquí: viven en Vercel y en `supabase secrets set`. Ver secrets.template.env.
# =============================================================================

VITE_SUPABASE_PROJECT_ID="ixkyfwzkknehvsqpopof"
VITE_SUPABASE_URL="https://ixkyfwzkknehvsqpopof.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_yZbJzRlZfQY0iMtloEr86Q_uSUiuxNY"

VITE_APP_BASE_URL="https://pasifyy.vercel.app"
VITE_PUBLIC_WEB_URL="https://pasifyy.vercel.app"
VITE_APP_NAME="Pasify"
VITE_DEFAULT_LOCALE="es"
VITE_SUPPORT_EMAIL="hola@pasify.es"

VITE_DEV_PREVIEW="false"
